# turns the webui files into a C++ header of byte arrays
# invoked at build time from the root CMakeLists
#
# the files are emitted as arrays instead of string literals because MSVC refuses any single
# literal over 16380 bytes (error C2026), which app.js is well past. an array also sidesteps
# source code page and utf-8 handling, the bytes reach the binary exactly as they are on disk

function(embed_file name path)
    file(READ "${path}" hex HEX)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    # break the lines up so the header stays readable and editors do not choke on it
    string(REGEX REPLACE "(0x[0-9a-f][0-9a-f],){24}" "\\0\n    " bytes "${bytes}")
    file(APPEND "${OUT_HEADER}" "inline const unsigned char ${name}_bytes[] = {\n    ${bytes}0x00\n};\n")
    file(APPEND "${OUT_HEADER}" "inline const char * ${name} = reinterpret_cast<const char *>(${name}_bytes);\n\n")
endfunction()

file(WRITE  "${OUT_HEADER}" "// generated by cmake/embed_webui.cmake, do not edit\n")
file(APPEND "${OUT_HEADER}" "#pragma once\n\n")
file(APPEND "${OUT_HEADER}" "namespace breeze_webui {\n\n")

embed_file(index_html "${WEBUI_DIR}/index.html")
embed_file(style_css  "${WEBUI_DIR}/style.css")
embed_file(app_js     "${WEBUI_DIR}/app.js")

file(APPEND "${OUT_HEADER}" "}\n")
